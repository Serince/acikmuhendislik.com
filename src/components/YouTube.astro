---
interface Props { id: string; title?: string; eager?: boolean }
const { id, title = 'YouTube video', eager = false } = Astro.props;
// Tıklanmadan iframe yüklenmez: ~500KB üçüncü taraf JS + font + çerez gecikmesi önlenir.
---
<div class="video-wrap" data-yt-lite data-yt={id}>
  <button type="button" class="video-facade" data-yt-dugme aria-label={`${title} videosunu oynat`}>
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      decoding="async"
      width="480"
      height="360"
    />
    <span class="video-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="68" height="68"><path fill="#fff" d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
</div>
