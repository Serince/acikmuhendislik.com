---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import YouTube from './YouTube.astro';
const { entry } = Astro.locals.starlightRoute;
const d = entry.data;
const videos = d.youtube ? (Array.isArray(d.youtube) ? d.youtube : [d.youtube]) : [];
const tarih = d.tarih ? new Date(d.tarih).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' }) : null;
// Kutu kaynagi: frontmatter'daki ozet alani (govdede tekrar etmez).
---
{(d.yazar || d.yazilim || tarih) && (
  <p class="ders-meta">
    {d.yazilim && <span class="etiket">{d.yazilim}</span>}
    {d.yazar && <span>Hazırlayan: {d.yazarKanal ? <a href={d.yazarKanal} target="_blank" rel="noopener">{d.yazar}</a> : d.yazar}</span>}
    {tarih && <span>· {tarih}</span>}
  </p>
)}
{d.dogrulama && (
  <p class="uyari">⚠️ Bu dersin video eşleşmesi arşivden otomatik kurtarıldı; lütfen doğru video olduğunu kontrol edin.</p>
)}
{videos.map((id, i) => <YouTube id={id} title={d.title} eager={i === 0} />)}
{videos.length > 0 && d.ozet && (
  <p class="ogrenme-hedefi">
    <strong>Bu derste:</strong> {(() => {
      // Ozetin ilk cumlesini atla (govdede aynen var); devamindan kisa teaser goster.
      const cumleler = d.ozet.match(/[^.!?]+[.!?]+/g) || [d.ozet];
      let teaser = (cumleler.length > 1 ? cumleler.slice(1).join(' ') : d.ozet).trim();
      teaser = teaser.replace(/^bu derste[,\s]*/i, '');
      teaser = teaser.charAt(0).toLocaleUpperCase('tr-TR') + teaser.slice(1);
      return teaser.length > 160 ? teaser.slice(0, 160).trimEnd() + '…' : teaser;
    })()}
  </p>
)}
<Default><slot /></Default>
