---
import kurslar from '../data/kurslar.json';

const gruplar = [
  { id: 'FEM', baslik: 'FEM — Sonlu Elemanlar', alt: 'Parça ve yapıların dayanım, titreşim ve burkulma analizleri.' },
  { id: 'CFD', baslik: 'CFD — Akışkanlar Dinamiği', alt: 'Boru içi akış, dış akış, çift fazlı akış ve mesh teknikleri.' },
  { id: 'Diger', baslik: 'Atölye — Donanım ve Otomasyon', alt: 'Açık donanım projeleri ve FreeCAD programlama.' },
];
---
<section class="istatistik" aria-label="Site istatistikleri">
  <div><strong>87</strong><span>video ders</span></div>
  <div><strong>13</strong><span>kurs</span></div>
  <div><strong>22</strong><span>gönüllü eğitmen</span></div>
  <div><strong>%100</strong><span>ücretsiz</span></div>
</section>

{gruplar.map((g) => (
  <>
    <h2 id={'grup-' + g.id.toLowerCase()} class="bolum-baslik">{g.baslik}</h2>
    <p class="bolum-alt">{g.alt}</p>
    <div class="kurs-grid">
      {kurslar.filter((k) => k.grup === g.id).map((k) => (
        <a class="kurs-kart" href={k.href}>
          <span class="kurs-kapak">
            <img src={k.img} alt={`${k.baslik} kurs kapağı`} loading="lazy" />
            <span class="kurs-seviye">{k.seviye}</span>
          </span>
          <span class="kurs-govde">
            <span class="kurs-yazilim">{k.yazilim}</span>
            <strong class="kurs-baslik">{k.baslik}</strong>
            <span class="kurs-aciklama">{k.aciklama}</span>
            <span class="kurs-meta">{k.ders} ders →</span>
          </span>
        </a>
      ))}
    </div>
  </>
))}
