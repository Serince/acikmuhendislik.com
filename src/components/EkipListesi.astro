---
import { getCollection } from 'astro:content';
import ekip from '../data/ekip.json';

// Ders dosyalarındaki yazarları topla: listede yoksa otomatik ekip üyesi yap (aynı isim birleşir)
const dersler = await getCollection('docs');
const norm = (s) => s.toLocaleLowerCase('tr-TR').replace(/\s+/g, ' ').trim();
const sabit = new Set(ekip.map((e) => norm(e.ad)));
const ek = new Map();
for (const d of dersler) {
  const y = (d.data.yazar || '').trim();
  if (!y || sabit.has(norm(y))) continue;
  if (!ek.has(norm(y))) ek.set(norm(y), { ad: y, kanal: null, yazilimlar: [], ders: 0 });
  const k = ek.get(norm(y));
  k.ders++;
  if (!k.kanal && d.data.yazarKanal) k.kanal = d.data.yazarKanal;
  if (d.data.yazilim && !k.yazilimlar.includes(d.data.yazilim)) k.yazilimlar.push(d.data.yazilim);
}
const yeniler = [...ek.values()];
const basHarf = (ad) => ad.split(' ').map((w) => w[0]).slice(0, 2).join('').toLocaleUpperCase('tr-TR');
const ikonlar = {
  Youtube: 'M23 12s0-3.85-.46-5.58a2.9 2.9 0 0 0-2-2C18.75 4 12 4 12 4s-6.75 0-8.54.42a2.9 2.9 0 0 0-2 2C1 8.15 1 12 1 12s0 3.85.46 5.58a2.9 2.9 0 0 0 2 2C5.25 20 12 20 12 20s6.75 0 8.54-.42a2.9 2.9 0 0 0 2-2C23 15.85 23 12 23 12zm-13.25 3.5v-7L15.5 12l-5.75 3.5z',
  Linkedin: 'M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z',
  Twitter: 'M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z',
  Github: 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.63-5.49 5.92.43.38.82 1.11.82 2.24l-.01 3.29c0 .31.22.7.83.58A12 12 0 0 0 12 .3z',
  'E-posta': 'M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5zm2.3.5L12 11l7.7-5.5H4.3z',
};
---
<div class="ekip" data-karistir>
  {ekip.map((m) => (
    <div class="ekip-kart">
      {m.foto ? <img src={m.foto} alt={m.ad} loading="lazy" /> : <span class="ekip-avatar">{basHarf(m.ad)}</span>}
      <h3>{m.ad}</h3>
      <p>{m.desc}</p>
      <div class="sosyal-satir">
        {m.links.map((l) => (
          <a class="sosyal" href={l.url} target="_blank" rel="noopener" title={l.type} aria-label={`${m.ad} - ${l.type}`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={ikonlar[l.type] || ikonlar['E-posta']} /></svg>
          </a>
        ))}
      </div>
    </div>
  ))}
  {yeniler.map((y) => (
    <div class="ekip-kart ekip-yeni">
      <span class="ekip-avatar">{basHarf(y.ad)}</span>
      <h3>{y.ad}</h3>
      <p>{y.yazilimlar.length ? y.yazilimlar.join(', ') + ' dersleri hazırlayan gönüllü eğitmen.' : 'Ders hazırlayan gönüllü eğitmen.'} Sitede {y.ders} dersi var.</p>
      {y.kanal && (
        <div class="sosyal-satir">
          <a class="sosyal" href={y.kanal} target="_blank" rel="noopener" title="Youtube" aria-label={`${y.ad} - Youtube`}>
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d={ikonlar.Youtube} /></svg>
          </a>
        </div>
      )}
    </div>
  ))}
</div>
<script>
  // Her ziyarette kartları karıştır
  document.querySelectorAll('[data-karistir]').forEach((alan) => {
    const kartlar = [...alan.children];
    for (let i = kartlar.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      alan.appendChild(kartlar[j]);
      kartlar.splice(j, 1);
    }
  });
</script>
