---
import Default from '@astrojs/starlight/components/Sidebar.astro';
---

<Default />

<script is:inline>
  // Tıklayınca-yüklenen YouTube videoları: document düzeyinde tek dinleyici (delegasyon).
  // Butonlar betikten sonra gelse bile çalışır; Starlight sayfa geçişlerinde de sorun çıkarmaz.
  document.addEventListener('click', (olay) => {
    const dugme = olay.target instanceof Element ? olay.target.closest('[data-yt-dugme]') : null;
    if (!dugme) return;
    const kutu = dugme.closest('.video-wrap[data-yt-lite]');
    if (!kutu || kutu.querySelector('iframe')) return;
    const id = kutu.getAttribute('data-yt') || '';
    if (!id) return;
    const baslik = dugme.getAttribute('aria-label') || 'YouTube video';
    const cerceve = document.createElement('iframe');
    cerceve.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
    cerceve.title = baslik;
    cerceve.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    cerceve.referrerPolicy = 'strict-origin-when-cross-origin';
    cerceve.allowFullscreen = true;
    cerceve.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;border:0';
    kutu.replaceChildren(cerceve);
  });
</script>

<script>
  // Aktif ders menüde görünür alana kaydırılsın:
  // sayfa açılışında ve Starlight sayfa geçişlerinde çalışır.
  function aktifLinkiGoster() {
    const aktif = document.querySelector('#starlight__sidebar a[aria-current="page"]');
    if (!aktif) return;
    let hedef = aktif.parentElement;
    while (hedef && hedef !== document.body) {
      const st = getComputedStyle(hedef);
      if (hedef.scrollHeight > hedef.clientHeight + 4 && /auto|scroll/.test(st.overflowY)) {
        hedef.scrollTo({ top: aktif.offsetTop - hedef.clientHeight / 2 + 40, behavior: 'smooth' });
        return;
      }
      hedef = hedef.parentElement;
    }
    aktif.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
  document.addEventListener('astro:page-load', aktifLinkiGoster);
  aktifLinkiGoster();
</script>
